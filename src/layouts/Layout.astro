---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { getSessions, url } from '../lib/content';

interface Props {
  title: string;
}

const { title } = Astro.props;
const campaign = await getEntry('campaign', 'index');
const siteTitle = campaign?.data.title ?? 'Mythic Bastionland';
const sessions = await getSessions();
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href.replace(/\/$/, '');

const sections = [
  { href: url('knights/'), label: 'Knights' },
  { href: url('npcs/'), label: 'NPCs' },
  { href: url('myths/'), label: 'Myths' },
  { href: url('holdings/'), label: 'Holdings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} · ${siteTitle}`}</title>
  </head>
  <body>
    <div class="band" aria-hidden="true"></div>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-button">Menu</label>
    <div class="shell">
      <aside class="sidebar">
        <a class="site-title gothic" href={url('')}>{siteTitle}</a>
        <nav>
          <a href={url('')} aria-current={isCurrent(url('')) ? 'page' : undefined}>Overview</a>
          <p class="nav-heading"><a href={url('sessions/')}>Sessions</a></p>
          <ol class="session-nav">
            {
              sessions.map((s) => {
                const href = url(`sessions/${s.id}/`);
                return (
                  <li>
                    <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                      <span class="num">{s.data.number}</span>
                      <span>{s.data.title ?? `Session ${s.data.number}`}</span>
                    </a>
                  </li>
                );
              })
            }
          </ol>
          <p class="nav-heading">The Realm</p>
          {
            sections.map((s) => (
              <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
                {s.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .band {
    height: 14px;
    background: var(--teal);
    border-bottom: 3px double var(--sage);
  }

  .shell {
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    min-height: calc(100vh - 17px);
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 1.4rem 1.2rem 2rem;
    border-right: 3px double var(--sage);
  }

  .site-title {
    display: block;
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 1.2rem;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--teal-mid);
    text-decoration: underline;
    text-decoration-color: var(--sage);
  }

  .nav-heading {
    margin: 1rem 0 0.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.85rem;
    color: var(--sage-deep);
  }

  .nav-heading a {
    color: inherit;
  }

  .session-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .session-nav a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .num {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    font-size: 0.9rem;
  }

  main {
    padding: 1.5rem clamp(1rem, 4vw, 3rem) 4rem;
    max-width: 58rem;
    width: 100%;
  }

  .nav-toggle,
  .nav-button {
    display: none;
  }

  @media (max-width: 760px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .nav-button {
      display: block;
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 0.5rem 1rem;
      background: var(--ink);
      color: var(--paper);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
    }

    .sidebar {
      display: none;
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 3px double var(--sage);
    }

    .nav-toggle:checked ~ .shell .sidebar {
      display: block;
    }
  }
</style>
