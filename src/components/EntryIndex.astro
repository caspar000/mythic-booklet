---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  items: { href: string; name: string; image?: ImageMetadata; status?: string; description?: string }[];
}

const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="muted">Nothing here yet.</p>
  ) : (
    <ul class="entries">
      {items.map((item) => (
        <li>
          <a href={item.href} class="card">
            {item.image ? (
              <Image src={item.image} alt="" width={160} height={160} class="pic" />
            ) : (
              <span class="pic blank" />
            )}
            <span class="text">
              <span class="name">{item.name}</span>
              {item.status && <StatusBadge status={item.status} />}
              {item.description && <span class="desc">{item.description}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .entries {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    color: var(--ink);
    text-decoration: none;
    padding: 0.6rem;
    border: 1px solid var(--row);
    background: color-mix(in srgb, var(--paper) 70%, white);
  }

  .card:hover {
    border-color: var(--ink);
  }

  .pic {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border: 2px solid var(--teal);
    flex: none;
  }

  .blank {
    display: block;
    background: var(--teal);
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }

  .name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .desc {
    color: var(--ink-soft);
  }
</style>
