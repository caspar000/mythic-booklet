---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
}

const { title, subtitle, image } = Astro.props;
---

<Layout title={title}>
  <h1 class="page-title">{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <div class:list={['entry', { 'has-image': image }]}>
    <div class="body">
      <slot />
    </div>
    {
      image && (
        <div class="frame art">
          <Image src={image} alt={title} width={720} />
        </div>
      )
    }
  </div>
</Layout>

<style>
  .entry.has-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 2rem;
    align-items: start;
  }

  .art {
    margin-top: 0;
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .entry.has-image {
      grid-template-columns: 1fr;
    }

    .art {
      order: -1;
    }
  }
</style>
